{
  "name": "HackNSeek Tools",
  "short_name": "HackNSeek",
  "description": "A collection of small, offline-capable web tools for musicians and tinkerers.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8f7f3",
  "theme_color": "#f8f7f3",
  "lang": "en",
  "categories": ["music", "utilities", "productivity"],
  "icons": [
    { "src": "icons/icon.svg",     "sizes": "any",     "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Metronome",  "url": "./#metronome",  "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tuner",      "url": "./#tuner",      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pitch Trace", "url": "./#pitch-trace", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Timer",      "url": "./#timer",      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tap Tempo",  "url": "./#tap-tempo",  "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Hexic",     "url": "./#hexic",      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "prefer_related_applications": false
}
